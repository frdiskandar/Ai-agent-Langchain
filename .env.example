# Provider LLM: ollama | lmstudio
LLM_PROVIDER=ollama

# --- Ollama (dipakai jika LLM_PROVIDER=ollama) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# --- LM Studio (dipakai jika LLM_PROVIDER=lmstudio) ---
# Base URL harus endpoint OpenAI-compatible LM Studio, biasanya diakhiri /v1.
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_MODEL=qwen2.5-7b-instruct
LMSTUDIO_API_KEY=lm-studio

# Repo/folder yang boleh dibaca & diubah oleh agent.
# Wajib diisi. Bisa juga lewat CLI: pnpm dev --dir /path/ke/repo
WORKSPACE_DIR=

# Penyimpanan riwayat percakapan (SQLite)
SQLITE_PATH=./data/checkpoints.sqlite

# Batas eksekusi
MAX_ITERATIONS=25
COMMAND_TIMEOUT_MS=30000
MAX_OUTPUT_CHARS=20000
MAX_FILE_BYTES=200000
