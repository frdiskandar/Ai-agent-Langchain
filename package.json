{
  "name": "agentic-ai",
  "version": "1.0.0",
  "description": "Coding agent CLI built with LangGraph, TypeScript, Ollama, and SQLite memory",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "agentic-ai": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:watch": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').chmodSync('dist/index.js', 0o755)\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "langgraph",
    "langchain",
    "ollama",
    "coding-agent",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=22"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.16.1",
  "dependencies": {
    "@langchain/core": "^1.3.4",
    "@langchain/langgraph": "^1.6.1",
    "@langchain/langgraph-checkpoint-sqlite": "^1.1.0",
    "@langchain/ollama": "^1.3.0",
    "@langchain/openai": "^1.8.0",
    "dotenv": "^18.0.9",
    "execa": "^10.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
